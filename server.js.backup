    };
    
  } catch (error) {
    console.error('❌ Error in dynamic prompt processing:', error);
    throw error;
  }
}

// 📝 NOTION TASK HANDLER
async function handleNotionTask(message, taskIntent) {
  try {
    console.log(`📝 Handling Notion task: ${taskIntent}`);
    
    switch (taskIntent) {
      case 'read_tasks':
        const tasks = await notionManager.getTasks();
        const taskMessage = notionManager.formatTasksForMessage(tasks);
        return {
          type: 'notion_task_response',
          message: taskMessage,
          action: 'display_tasks'
        };
        
      case 'add_task':
        const taskData = notionManager.parseTaskFromMessage(message);
        const newTask = await notionManager.addTask(taskData);
        return {
          type: 'notion_task_response',
          message: `✅ **Task Added to Notion!**\n\n📝 **${newTask.title}**\n🔗 [View in Notion](${newTask.url})\n\n🎯 Your task has been added to your personal Notion workspace.`,
          action: 'task_added'
        };
        
      default:
        return {
          type: 'notion_task_response',
          message: '📝 I can help you manage your Notion tasks! Try:\n• "What are my tasks today?"\n• "Add task: Call the dentist"\n• "Show my todo list"',
          action: 'help'
        };
    }
  } catch (error) {
    console.error('❌ Notion task error:', error);
    return {
      type: 'notion_task_response',
      message: `❌ Sorry, I couldn't process your Notion task: ${error.message}`,
      action: 'error'
    };
  }
}

// 🚀 ENHANCED ANALYSIS RESULT HANDLER
async function handleEnhancedAnalysisResult(chatId, originalMessage, result) {
  const { analysis, response, requiresVoice } = result;
  
  // Handle Notion task responses
  if (result.type === 'notion_task_response') {
    const messageToSend = result.message;
    
    // Send text response
    await sendTelegramMessage(chatId, messageToSend);
    
    // Send voice response if requested
    if (requiresVoice) {
      await sendVoiceResponse(chatId, messageToSend);
    }
    
    return;
  }
  
  // Handle regular analysis results
  await handleAnalysisResult(chatId, originalMessage, result);
  
  // Send voice response if requested
  if (requiresVoice && response) {
    await sendVoiceResponse(chatId, response);
  }
}

// 🎤 ENHANCED VOICE RESPONSE HANDLER (Groq TTS)
async function sendVoiceResponse(chatId, text, voiceOptions = {}) {
  try {
    console.log('🎤 Generating voice response with Groq TTS...');
    
    // Auto-detect language and select appropriate voice
    const { model, voice } = voiceSystem.detectLanguageAndVoice(text);
    
    // Use custom voice if provided, otherwise use auto-detected
    const finalVoice = voiceOptions.voice || voice;
    
    console.log(`🎤 Using voice: ${finalVoice} (Model: ${model})`);
    
    const audioBuffer = await voiceSystem.textToSpeech(text, finalVoice);
    
    if (audioBuffer) {
      // Send voice message via Telegram
      const form = new FormData();
      form.append('chat_id', chatId);
      form.append('voice', audioBuffer, {
        filename: 'response.mp3',
        contentType: 'audio/mpeg'
      });
      
      const response = await fetch(`https://api.telegram.org/bot${TELEGRAM_TOKEN}/sendVoice`, {
        method: 'POST',
        body: form
      });
      
      if (response.ok) {
        console.log('✅ Voice response sent successfully');
      } else {
        console.error('❌ Failed to send voice response:', await response.text());
      }
    } else {
      console.log('⚠️ No audio buffer generated, skipping voice response');
    }
  } catch (error) {
    console.error('❌ Voice response error:', error);
  }
}

async function handleAnalysisResult(chatId, originalMessage, result) {
  const { analysis, response } = result;
  
  // Log analysis for debugging
  console.log('📊 Analysis Result:', {
    intent: analysis.intent,
    suggested_action: analysis.suggested_action,
    required_tools: analysis.required_tools.map(t => t.tool)
  });
  
  // Execute specific actions based on analysis
  switch (analysis.suggested_action) {
    case 'financial_query':
      await handleFinancialQuery(chatId, originalMessage, response);
      break;
      
    case 'team_performance_query':
      await handleTeamPerformanceQuery(chatId, originalMessage, response);
      break;
      
    case 'project_status_query':
      await handleProjectStatusQuery(chatId, originalMessage, response);
      break;
      
    case 'create_bug_issue':
      await handleBugReport(chatId, originalMessage, response);
      break;
      
    case 'create_feature_request':
      await handleFeatureRequest(chatId, originalMessage, response);
      break;
      
    default:
      // Send AI response for general queries
      await sendTelegramMessage(chatId, response);
  }
}

// 💰 FINANCIAL QUERY HANDLER WITH SUPABASE MCP
async function handleFinancialQuery(chatId, message, aiResponse) {
  try {
    await sendTelegramMessage(chatId, `💰 Querying Financial Database...`);
    
    // Execute actual Supabase query for software expenses
    const financialData = await querySupabaseFinancialData(message);
    
    if (financialData.success) {
      const formattedResponse = `💰 **Year-to-Date Software Expenses**

📊 **Total Spent**: £${financialData.total}
🗓️ **Period**: January 1 - ${new Date().toLocaleDateString()}
📝 **Transactions**: ${financialData.count} payments

🔝 **Top Expenses**:
${financialData.breakdown.map(item => `• ${item.description}: £${item.amount}`).join('\n')}

📈 **AI Insights**: ${aiResponse}

💡 **Recommendations**:
• Consider annual subscriptions for better pricing
• Review unused services monthly
• Track ROI on expensive tools`;

      await sendTelegramMessage(chatId, formattedResponse);
      
      // Add quick action buttons
      const keyboard = {
        inline_keyboard: [
          [{ text: '📊 Detailed Breakdown', callback_data: 'financial_breakdown' }],
          [{ text: '📈 Monthly Trends', callback_data: 'financial_trends' }],
          [{ text: '💡 Cost Optimization', callback_data: 'cost_optimization' }]
        ]
      };
      
      await sendTelegramMessage(chatId, '🎯 What would you like to explore?', keyboard);
    } else {
      await sendTelegramMessage(chatId, `❌ Database query failed: ${financialData.error}`);
    }
    
  } catch (error) {
    console.error('❌ Financial query error:', error);
    await sendTelegramMessage(chatId, `❌ Error processing financial query: ${error.message}`);
  }
}

