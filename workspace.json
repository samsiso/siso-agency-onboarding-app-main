{
  "version": 2,
  "projects": {
    "siso-agency": {
      "root": "projects/siso-agency-web",
      "sourceRoot": "projects/siso-agency-web/src",
      "projectType": "application",
      "targets": {
        "build": {
          "executor": "@nx/vite:build",
          "outputs": ["{options.outputPath}"],
          "options": {
            "outputPath": "dist/siso-agency"
          }
        },
        "serve": {
          "executor": "@nx/vite:dev-server",
          "options": {
            "buildTarget": "siso-agency:build"
          }
        }
      }
    },
    "claudia-desktop": {
      "root": "projects/claudia-desktop",
      "sourceRoot": "projects/claudia-desktop/src",
      "projectType": "application",
      "targets": {
        "build": {
          "executor": "@tauri-apps/cli:build",
          "options": {
            "outputPath": "dist/claudia-desktop"
          }
        },
        "serve": {
          "executor": "@tauri-apps/cli:dev",
          "options": {
            "buildTarget": "claudia-desktop:build"
          }
        }
      }
    },
    "shared": {
      "root": "projects/shared",
      "sourceRoot": "projects/shared/src",
      "projectType": "library",
      "targets": {
        "build": {
          "executor": "@nx/vite:build",
          "outputs": ["{options.outputPath}"],
          "options": {
            "outputPath": "dist/shared"
          }
        }
      }
    }
  }
}